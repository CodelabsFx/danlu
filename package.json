{
  "name": "danlu-inventory",
  "version": "0.1.0",
  "main": "server/src/index.js",
  "scripts": {
    "start": "node server/src/index.js",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon server/src/index.js",
    "dev:client": "npm --prefix client run dev -- --host 0.0.0.0",
    "test": "cross-env DISABLE_CRON=1 jest --runInBand",
    "test:unit": "cross-env DISABLE_CRON=1 jest --runInBand --testPathIgnorePatterns=server/tests/integration",
    "test:integration": "cross-env DISABLE_CRON=1 jest --runInBand server/tests/integration"
  },
  "dependencies": {
    "bcrypt": "^5.1.0",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "express-rate-limit": "^6.8.0",
    "jsonwebtoken": "^9.0.0",
    "node-cron": "^3.0.2",
    "nodemailer": "^6.9.3",
    "pg": "^8.9.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "nodemon": "^2.0.22",
    "jest": "^29.6.1",
    "supertest": "^6.3.3",
    "cross-env": "^7.0.3",
    "pg-mem": "^2.1.0"
  }
}
